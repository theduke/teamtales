# Local MySQL started by `npm run db:up`.
DATABASE_URL=mysql://teamtales:password@127.0.0.1:3306/teamtales

# Local API and browser settings.
TEAMTALES_PUBLIC_ORIGIN=http://127.0.0.1:9101
TEAMTALES_COOKIE_SECURE=false

# Development-only credential encryption key. Do not use in production.
TEAMTALES_CREDENTIAL_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TEAMTALES_AUTO_MIGRATE=true
# Process queued provider syncs in the local API process.
TEAMTALES_SYNC_WORKER=true
TEAMTALES_SYNC_WORKER_BATCH_SIZE=3
LOG_LEVEL=debug
