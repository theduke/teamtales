# Standard connection URL (preferred outside Wasmer)
DATABASE_URL=mysql://teamtales:password@127.0.0.1:3306/teamtales

# Wasmer database capability variables (used when DATABASE_URL is unset)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=teamtales
# DB_USERNAME=teamtales
# DB_PASSWORD=password
# DB_NAME=teamtales

PORT=8080
TEAMTALES_API_HOST=0.0.0.0
TEAMTALES_PUBLIC_ORIGIN=http://localhost:8080
TEAMTALES_COOKIE_SECURE=false
# Enable only for local development. Production deployments should run `teamtales migrate` separately.
TEAMTALES_AUTO_MIGRATE=true
TEAMTALES_CREDENTIAL_KEY=replace-with-at-least-32-random-bytes
# Enabled by default outside production. Set false when an external worker owns sync processing.
TEAMTALES_SYNC_WORKER=true
TEAMTALES_SYNC_WORKER_BATCH_SIZE=3
