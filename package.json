{
  "name": "teamtales",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "cli": "vp run @teamtales/server#cli",
    "dev": "vp run -r --parallel dev",
    "dev:server": "vp run @teamtales/server#dev",
    "dev:ui": "vp run @teamtales/ui#dev",
    "dev:all": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "start": "node packages/server/dist/server.js",
    "ui:dev": "vp run @teamtales/ui#dev",
    "ui:build": "vp run @teamtales/ui#build",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "vp run -r typecheck",
    "schema:check": "vp run @teamtales/server#schema:check",
    "test": "vp run @teamtales/server#test",
    "check": "vp check && vp run -r typecheck && vp run @teamtales/server#test && vp run build && vp run @teamtales/server#schema:check"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vite-plus": "0.2.4"
  },
  "packageManager": "npm@11.13.0"
}
