{
  "name": "@teamtales/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "teamtales": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "tsx src/api/dev-server.ts",
    "api:dev": "npm run dev:api",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "schema:check": "drizzle-kit check --config drizzle.config.ts",
    "build": "esbuild src/api/production-server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm run schema:check"
  },
  "dependencies": {
    "@teamtales/common": "file:../common",
    "drizzle-orm": "^1.0.0-beta.16-c2458b2",
    "mysql2": "^3.14.4",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "drizzle-kit": "^1.0.0-beta.16-2ffd1a5",
    "esbuild": "^0.25.6"
  }
}
