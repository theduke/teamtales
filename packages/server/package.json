{
  "name": "@teamtales/server",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "teamtales": "./src/cli/index.ts"
  },
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vp exec tsx watch --env-file=../../.env.development src/api/dev-server.ts",
    "dev:api": "vp exec tsx watch --env-file=../../.env.development src/api/dev-server.ts",
    "api:dev": "vp exec tsx watch --env-file=../../.env.development src/api/dev-server.ts",
    "cli": "vp exec tsx src/cli/index.ts",
    "migrate:github-resources": "vp exec tsx src/cli/index.ts migrate github-resources",
    "typecheck": "tsc --noEmit",
    "schema:check": "drizzle-kit check --config drizzle.config.ts",
    "build": "vp exec esbuild src/api/production-server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "test": "vp exec tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "check": "vp check && vp run typecheck && vp run schema:check"
  },
  "dependencies": {
    "@teamtales/common": "file:../common",
    "drizzle-orm": "^1.0.0-beta.16-c2458b2",
    "mysql2": "^3.14.4",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "drizzle-kit": "^1.0.0-beta.16-2ffd1a5",
    "esbuild": "^0.25.6"
  }
}
